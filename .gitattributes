# Preserve the original archive member's bytes and CRLF line endings.
examples/ground_imagery/_data/wiki_solar_join.csv -text whitespace=cr-at-eol

# Mars observations retain source checksums and original line endings.
examples/mars/_data/*.csv -text whitespace=cr-at-eol
examples/mars/_data/*.txt -text whitespace=cr-at-eol
examples/mars/_data/*.xml -text whitespace=cr-at-eol,-space-before-tab

# Lunar source subsets, labels and generated bundles retain checksummed bytes.
examples/lunar/_data/* -text whitespace=cr-at-eol,-space-before-tab
examples/lunar/_data/*.xml -text whitespace=cr-at-eol,-blank-at-eol,-space-before-tab
