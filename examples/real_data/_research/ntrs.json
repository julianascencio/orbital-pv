{"stats":{"took":66,"total":37,"estimate":false,"maxScore":95.566376},"results":[{"_meta":{"score":95.566376},"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"OTHER","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":19880024566,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"a7815037674644c3b761bcce2f7ac5f9","belongsToAuthors":false},"subjectCategories":["Energy Production And Conversion"],"exportControl":{"isExportControl":"NO","submissionId":19880024566,"ear":"NO","id":"f4d8064658fb40caa728a311b6a29e50","itar":"NO"},"distributionDate":"2019-07-12T00:00:00.0000000+00:00","fundingNumbers":[{"number":"JPL-957358","submissionId":19880024566,"id":"9218e099bd894c1cbd593851a4ff391f","type":"CONTRACT_GRANT"}],"title":"Advanced photovoltaic solar array design","stiType":"CONFERENCE_PAPER","distribution":"PUBLIC","submittedDate":"2013-08-13T13:53:00.0000000+00:00","authorAffiliations":[{"sequence":0,"submissionId":19880024566,"meta":{"author":{"name":"Kurland, Richard"},"organization":{"name":"TRW, Inc.","location":"TRW Space and Technology Group, Redondo Beach, CA, United States"}},"id":"5a11ae3295694e32a7badcfa98cc2a92"},{"sequence":1,"submissionId":19880024566,"meta":{"author":{"name":"Stella, Paul"},"organization":{"name":"California Institute of Technology","location":"Jet Propulsion Laboratory, Pasadena, United States"}},"id":"4ec6c794c949493e9d55f5d493a8f2fa"}],"stiTypeDetails":"Conference Paper","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":19880024566,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":"88A11793"},"created":"2013-08-13T13:53:00.0000000+00:00","center":{"code":"CDMS","name":"Legacy CDMS","id":"092d6e0881874968859b972d39a888dc"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"An ultralightweight flexible-blanket flatpack, foldout solar array design is defined. The design establishes a critical intermediate milestone of the NASA high-performance Advanced Photovoltaic Solar Array program through its primary objective of realistically demonstrating a solar array that can provide greater than 130 W/kg at beginning of life (BOL) and 100 W/kg at end of life for a 10-year geosynchronous 10-kW (BOL) space power system. This paper reviews the critical features of the preliminary design and the implications for long-term array technology development.","isLessonsLearned":false,"disseminated":"METADATA_ONLY","meetings":[{"country":"United States","submissionId":19880024566,"endDate":"1987-08-14T00:00:00.0000000+00:00","name":"IECEC ''87","location":"Philadelphia, PA","id":"8787800733e640faa6d70188009ae9d4","startDate":"1987-08-10T00:00:00.0000000+00:00"}],"publications":[{"submissionId":19880024566,"id":"c6532e71a61947189033a8b766d61094","publicationDate":"1987-01-01T00:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[],"downloadsAvailable":false,"index":"submissions-2026-10-29-05-27"},{"_meta":{"score":94.427376},"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"GOV_PUBLIC_USE_PERMITTED","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":20050187008,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"c554ae86c70941c28e1e7ca4e4b733f8","belongsToAuthors":false},"subjectCategories":["Solar Physics"],"exportControl":{"isExportControl":"NO","submissionId":20050187008,"ear":"NO","id":"4908c8741f2644e19c48b8d7bb3cd0f1","itar":"NO"},"distributionDate":"2018-06-04T00:00:00.0000000+00:00","title":"Solar Array Verification Analysis Tool (SAVANT) Developed","stiType":"OTHER","distribution":"PUBLIC","submittedDate":"2013-09-07T12:08:00.0000000+00:00","authorAffiliations":[{"sequence":0,"submissionId":20050187008,"meta":{"author":{"name":"Bailey, Sheila G."},"organization":{"name":"NASA Lewis Research Center","location":"Cleveland, OH, United States"}},"id":"c4c3f25186714ffeb6586dc0673c1802"},{"sequence":1,"submissionId":20050187008,"meta":{"author":{"name":"Long, KIenwyn J."},"organization":{"name":"NASA Lewis Research Center","location":"Cleveland, OH, United States"}},"id":"2636e650078144a499a0d08baac15cc6"},{"sequence":2,"submissionId":20050187008,"meta":{"author":{"name":"Curtis, Henry B."},"organization":{"name":"NASA Lewis Research Center","location":"Cleveland, OH, United States"}},"id":"822c71335dd648599b9c645f2adf2544"},{"sequence":3,"submissionId":20050187008,"meta":{"author":{"name":"Gardner, Barbara"},"organization":{"name":"NASA Lewis Research Center","location":"Cleveland, OH, United States"}},"id":"da80c6e6aa7743b3aaaa20769d31fea6"},{"sequence":4,"submissionId":20050187008,"meta":{"author":{"name":"Davis, Victoria"},"organization":{"name":"NASA Lewis Research Center","location":"Cleveland, OH, United States"}},"id":"a1f9d1bffb74465996ff7b9e16e44940"},{"sequence":5,"submissionId":20050187008,"meta":{"author":{"name":"Messenger, Scott"},"organization":{"name":"NASA Lewis Research Center","location":"Cleveland, OH, United States"}},"id":"113b891335d3466ab51101482ebd3bb0"},{"sequence":6,"submissionId":20050187008,"meta":{"author":{"name":"Walters, Robert"},"organization":{"name":"NASA Lewis Research Center","location":"Cleveland, OH, United States"}},"id":"54c9b5ee37a0448abac23377a7ff0713"}],"stiTypeDetails":"Other","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":20050187008,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":""},"created":"2013-09-07T12:08:00.0000000+00:00","center":{"code":"CDMS","name":"Legacy CDMS","id":"092d6e0881874968859b972d39a888dc"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"Modeling solar cell performance for a specific radiation environment to obtain the end-of-life photovoltaic array performance has become both increasingly important and, with the rapid advent of new types of cell technology, more difficult. For large constellations of satellites, a few percent difference in the lifetime prediction can have an enormous economic impact. The tool described here automates the assessment of solar array on-orbit end-of-life performance and assists in the development and design of ground test protocols for different solar cell designs. Once established, these protocols can be used to calculate on-orbit end-of-life performance from ground test results. The Solar Array Verification Analysis Tool (SAVANT) utilizes the radiation environment from the Environment Work Bench (EWB) model developed by the NASA Lewis Research Center s Photovoltaic and Space Environmental Effects Branch in conjunction with Maxwell Technologies. It then modifies and combines this information with the displacement damage model proposed by Summers et al. (ref. 1) of the Naval Research Laboratory to determine solar cell performance during the course of a given mission. The resulting predictions can then be compared with flight data. The Environment WorkBench (ref. 2) uses the NASA AE8 (electron) and AP8 (proton) models of the radiation belts to calculate the trapped radiation flux. These fluxes are integrated over the defined spacecraft orbit for the duration of the mission to obtain the total omnidirectional fluence spectra. Components such as the solar cell coverglass, adhesive, and antireflective coatings can slow and attenuate the particle fluence reaching the solar cell. In SAVANT, a continuous slowing down approximation is used to model this effect.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","publications":[{"submissionId":20050187008,"id":"199cff3ad886459892f64807ad81760e","publicationName":"Research and Technology 1998","publicationDate":"1999-08-01T00:00:00.0000000+00:00"}],"status":"CURATED","related":[{"disseminated":"DOCUMENT_AND_METADATA","id":19990052647,"type":"ANALYTIC_PRIMARY","title":"1998 Research and Technology","stiType":"TECHNICAL_MEMORANDUM","distribution":"PUBLIC","status":"CURATED"},{"disseminated":"DOCUMENT_AND_METADATA","id":19990052647,"type":"ANALYTIC_PRIMARY","title":"1998 Research and Technology","stiType":"TECHNICAL_MEMORANDUM","distribution":"PUBLIC","status":"CURATED"}],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"20050187008.pdf","type":"STI","links":{"original":"/api/citations/20050187008/downloads/20050187008.pdf","pdf":"/api/citations/20050187008/downloads/20050187008.pdf","fulltext":"/api/citations/20050187008/downloads/20050187008.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-10-29-05-27"},{"_meta":{"score":91.29905},"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"PUBLIC_USE_PERMITTED","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":20170010684,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"a69236d6e0a04f5f89ddc1da466180a9","belongsToAuthors":false},"subjectCategories":["Electronics And Electrical Engineering"],"exportControl":{"isExportControl":"NO","submissionId":20170010684,"ear":"NO","id":"df12438445704f829399542538a0d0e2","itar":"NO"},"distributionDate":"2019-07-12T00:00:00.0000000+00:00","otherReportNumbers":["GRC-E-DAA-TN46846","Report Number: GRC-E-DAA-TN46846"],"fundingNumbers":[{"number":"WBS 432938.11.01.03.06.01.05","submissionId":20170010684,"id":"f4c6fb81be17445c9c5c6ef19f769925","type":"WBS"},{"number":"NNC16CA19C","submissionId":20170010684,"id":"072e2882bb694e1381be19ba2ef188db","type":"CONTRACT_GRANT"},{"number":"NNN06AA01C","submissionId":20170010684,"id":"1218ac1a0c8a4a2bbf3d43145f6a6511","type":"CONTRACT_GRANT"}],"title":"Transformational Solar Array Final Report","stiType":"CONTRACTOR_OR_GRANTEE_REPORT","distribution":"PUBLIC","submittedDate":"2017-11-07T11:44:06.4700000+00:00","authorAffiliations":[{"sequence":0,"submissionId":20170010684,"meta":{"author":{"name":"Gaddy, Edward"},"organization":{"name":"Johns Hopkins Univ.","location":"Laurel, MD, United States"}},"id":"fba01bd4b8c843ef963d942c30a9b326"},{"sequence":1,"submissionId":20170010684,"meta":{"author":{"name":"Ballarotto, Mihaela"},"organization":{"name":"Johns Hopkins Univ.","location":"Laurel, MD, United States"}},"id":"8c043db778eb4f39a86c5d86ef0286e9"},{"sequence":2,"submissionId":20170010684,"meta":{"author":{"name":"Drabenstadt, Christian"},"organization":{"name":"Johns Hopkins Univ.","location":"Laurel, MD, United States"}},"id":"333c0145d27e4b70ba092d72b2916040"},{"sequence":3,"submissionId":20170010684,"meta":{"author":{"name":"Nichols, John"},"organization":{"name":"Johns Hopkins Univ.","location":"Laurel, MD, United States"}},"id":"c6bd2b312bb74e089b759e043f074a97"},{"sequence":4,"submissionId":20170010684,"meta":{"author":{"name":"Douglas, Mark"},"organization":{"name":"Deployable Space Systems (DDS)","location":"United States"}},"id":"e061ea2f4d0a4ce5b87b9eb8b169d7de"},{"sequence":5,"submissionId":20170010684,"meta":{"author":{"name":"Spence, Brian"},"organization":{"name":"Deployable Space Systems (DDS)","location":"United States"}},"id":"42345ff846d247ac8a07d457beb65091"},{"sequence":6,"submissionId":20170010684,"meta":{"author":{"name":"Stall, Richard A."},"organization":{"name":"Newforge Technologies","location":"CA, United States"}},"id":"cdde00634eaa4cd8b96d7bd5a0098653"},{"sequence":7,"submissionId":20170010684,"meta":{"author":{"name":"Sulyma, Chris"},"organization":{"name":"SolAero Technologies","location":"Albuquerque, NM, United States"}},"id":"02b9cbee287a4fd2b4cae53ae3a769d6"},{"sequence":8,"submissionId":20170010684,"meta":{"author":{"name":"Sharps, Paul"},"organization":{"name":"SolAero Technologies","location":"Albuquerque, NM, United States"}},"id":"3f5379d235864e9380f97159cbf75c6d"}],"stiTypeDetails":"Contractor or Grantee Report","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":20170010684,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":""},"created":"2017-11-07T11:44:06.4700000+00:00","center":{"code":"GRC","name":"Glenn Research Center","id":"19eeb25fa404421d9eaa5f876e853e3c"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"We have made outstanding progress in the Base Phase towards achieving the final NASA Research Announcement (NRA) goals. Progress is better than anticipated due to the lighter than predicted mass of the IMM solar cells. We look forward to further improvements in the IMM cell performance during Option I and Option II; so, we have confidence that the first four items listed in the table will improve to better than the NRA goals. The computation of the end of life blanket efficiency is uncertain because we have extrapolated the radiation damage from room temperature measurements. The last three items listed in the Table were not intended to be accomplished during the Base Phase; they will be achieved during Option I and Option II. ","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","publications":[{"submissionId":20170010684,"id":"49c7acdfa4dc4020b7d19db84dc3be72","publicationDate":"2017-04-26T00:00:00.0000000+00:00"}],"status":"CURATED","related":[{"disseminated":"DOCUMENT_AND_METADATA","id":20200000669,"type":"SUPPLEMENT_TO","title":"Transformational Solar Array Option I Final Report","stiType":"CONTRACTOR_OR_GRANTEE_REPORT","distribution":"PUBLIC","status":"CURATED"},{"disseminated":"DOCUMENT_AND_METADATA","id":20200000669,"type":"SUPPLEMENTED_BY","title":"Transformational Solar Array Option I Final Report","stiType":"CONTRACTOR_OR_GRANTEE_REPORT","distribution":"PUBLIC","status":"CURATED"}],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"20170010684.pdf","type":"STI","links":{"original":"/api/citations/20170010684/downloads/20170010684.pdf","pdf":"/api/citations/20170010684/downloads/20170010684.pdf","fulltext":"/api/citations/20170010684/downloads/20170010684.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-10-29-05-27"},{"_meta":{"score":88.82962},"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"approverComments":"Distribution within the U.S. granted by agreement","containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"OTHER","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":19900008481,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"57e4841d2bd9407c806b8e1ab74053f1","belongsToAuthors":false},"subjectCategories":["Spacecraft Propulsion And Power"],"exportControl":{"isExportControl":"NO","submissionId":19900008481,"ear":"NO","id":"9b264965a4a44f70a2c44a1fd480ac48","itar":"NO"},"distributionDate":"2013-08-27T00:00:00.0000000+00:00","title":"The advanced photovoltaic solar array program","stiType":"CONFERENCE_PAPER","distribution":"PUBLIC","submittedDate":"2013-09-06T15:07:00.0000000+00:00","authorAffiliations":[{"sequence":0,"submissionId":19900008481,"meta":{"author":{"name":"Kurland, R. M."},"organization":{"name":"TRW Space Technology Labs.","location":"Redondo Beach, CA., United States"}},"id":"d3a46309b2ab4ab7bad7709aa2f16060"},{"sequence":1,"submissionId":19900008481,"meta":{"author":{"name":"Stella, Paul M."},"organization":{"name":"Jet Propulsion Lab., California Inst. of Tech.","location":"Pasadena, CA, United States"}},"id":"1dea569ac706479d81fe511bd51cb149"}],"stiTypeDetails":"Conference Paper","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":19900008481,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":"90N17797"},"created":"2013-09-06T15:07:00.0000000+00:00","center":{"code":"CDMS","name":"Legacy CDMS","id":"092d6e0881874968859b972d39a888dc"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"The background and development status of an ultralightweight flexible-blanket flatpack, fold-out solar array is presented. It is scheduled for prototype demonstration in late 1989. The Advanced Photovoltaic Solar Array (APSA) design represents a critical intermediate milestone of the goal of 300 W/kg at beginning-of-life (BOL) with specific performance characteristics of 130 W/kg (BOL) and 100 W/kg at end-of-life (EOL) for a 10-year geosynchronous geostationary earth orbit 10-kW (BOL) space power system. The APSA wing design is scalable over a power range of 2 to 15 kW and is suitable for a full range of missions including Low Earth Orbit (LEO), orbital transfer from LEO to geostationary earth orbit and interplanetary flight.","isLessonsLearned":false,"disseminated":"METADATA_ONLY","publications":[{"submissionId":19900008481,"id":"16d142a15747467ea355dbeffba5fed0","publicationName":"ESA, European Space Power, Volume 2","publicationDate":"1989-08-01T00:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[],"downloadsAvailable":true,"index":"submissions-2026-10-29-05-27"},{"_meta":{"score":86.83769},"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"GOV_PUBLIC_USE_PERMITTED","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":19870016996,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"406fbaba88e549bcbd776d17fc56d1d1","belongsToAuthors":false},"subjectCategories":["Energy Production And Conversion"],"exportControl":{"isExportControl":"NO","submissionId":19870016996,"ear":"NO","id":"d5933e481b5f413fa4c3ccc33cde5d13","itar":"NO"},"distributionDate":"2013-08-29T00:00:00.0000000+00:00","title":"Advanced photovoltaic solar array design assessment","stiType":"CONFERENCE_PAPER","distribution":"PUBLIC","submittedDate":"2013-09-05T11:14:00.0000000+00:00","authorAffiliations":[{"sequence":0,"submissionId":19870016996,"meta":{"author":{"name":"Stella, Paul"},"organization":{"name":"Jet Propulsion Lab., California Inst. of Tech.","location":"Pasadena, CA, United States"}},"id":"5b31134b5c174f11b1701c3d810f0f41"},{"sequence":1,"submissionId":19870016996,"meta":{"author":{"name":"Scott-Monck, John"},"organization":{"name":"Jet Propulsion Lab., California Inst. of Tech.","location":"Pasadena, CA, United States"}},"id":"9fc40522c9374532a56fbe546f11e015"}],"stiTypeDetails":"Conference Paper","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":19870016996,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":"87N26429"},"created":"2013-09-05T11:14:00.0000000+00:00","center":{"code":"CDMS","name":"Legacy CDMS","id":"092d6e0881874968859b972d39a888dc"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"The Advanced Photovoltaic Solar Array (APSA) program seeks to bring to flight readiness a solar array that effectively doubles the specific power of the Solar Array Flight Experiment/Solar Electric Propulsion (SAFE/SEP) design that was successfully demonstrated during the Shuttle 41-D mission. APSA is a critical intermediate milestone in the effort to demonstrate solar array technologies capable of 300 W/kg and 300 W/square m at beginning of life (BOL). It is not unreasonable to anticipate the development of solar array designs capable of 300 W/kg at BOL for operational power levels approx. greater than 25 kW sub e. It is also quite reasonable to expect that high performance solar arrays capable of providing at lea