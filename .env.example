SPACE_PV_POSTGRES_DSN=postgresql+psycopg://spacepv:spacepv@localhost:5432/spacepv
SPACE_PV_DUCKDB_PATH=data/space_pv.duckdb
SPACE_PV_CELERY_BROKER_URL=redis://localhost:6379/0
SPACE_PV_CELERY_RESULT_BACKEND=redis://localhost:6379/1
SPACE_PV_API_HOST=0.0.0.0
SPACE_PV_API_PORT=8000
SPACE_PV_CORS_ORIGINS=http://localhost:5173

# Share this persistent cache across API workers on the same host.
SPACE_PV_GP_CACHE_PATH=data/cache/gp.sqlite3
# Set false for live-map-only development without PostgreSQL.
SPACE_PV_BOOTSTRAP_DATABASE=true
# Optional Python connector; never put this key into VITE_* variables.
# N2YO_API_KEY=
